{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Searchly Smart Rules",
  "type": "object",
  "required": [
    "version",
    "settings",
    "modes",
    "filters",
    "combinations"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "settings": {
      "type": "object",
      "required": [
        "phraseWeight",
        "keywordWeight",
        "tieMinScore",
        "maxSuggestions"
      ],
      "properties": {
        "phraseWeight": {
          "type": "number",
          "minimum": 0
        },
        "keywordWeight": {
          "type": "number",
          "minimum": 0
        },
        "tieMinScore": {
          "type": "number",
          "minimum": 0
        },
        "maxSuggestions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "icon",
          "label"
        ],
        "properties": {
          "icon": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "phrases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "action",
          "label",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "priority": {
            "type": "number"
          },
          "phrases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "combinations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "requires",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target": {
            "type": "string"
          },
          "priority": {
            "type": "number"
          },
          "icon": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}